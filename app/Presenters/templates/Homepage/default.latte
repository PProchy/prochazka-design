{define arrow}<svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>{/define}
{define github}<svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>{/define}
{define linkedin}<svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>{/define}

{block content}
{var $email = 'pprochy55@gmail.com'}
{var $linkedin = 'https://www.linkedin.com/in/pavel-proch%C3%A1zka-b20930192/'}
{var $github = 'https://github.com/PProchy'}

{* Hero *}
<section class="hero">
	<div class="container">
		<div class="hero__text">
			<p class="status reveal"><span class="status__dot" aria-hidden="true"></span>Otevřený novým projektům i spolupráci</p>

			<h1 class="hero__title reveal">
				Stavím weby a&nbsp;aplikace, <em>na které se dá spolehnout.</em>
			</h1>

			<p class="hero__lead reveal">
				Jsem Ing. Pavel Procházka, full-stack vývojář. PHP (Nette, Symfony) na backendu,
				moderní JavaScript na frontendu a&nbsp;všechno dotažené až do nasazení a&nbsp;provozu.
			</p>

			<div class="hero__actions reveal">
				<a href="mailto:{$email}?subject=Popt%C3%A1vka%20projektu" class="button button--primary">Poptat projekt</a>
				<a href="#prace" class="button button--ghost">Prohlédnout práci</a>
			</div>

			<p class="hero__aside reveal">
				Hledáte vývojáře do týmu? <a href="#spoluprace" class="link">Co nabízím firmám</a>
			</p>
		</div>

		<dl class="facts reveal">
			<div><dt>Zaměření</dt><dd>Webové aplikace na míru</dd></div>
			<div><dt>Hlavní stack</dt><dd>Symfony · Nette · Vue.js</dd></div>
			<div><dt>Rozsah</dt><dd>Návrh → vývoj → provoz</dd></div>
		</dl>
	</div>
</section>

{* Projects *}
<section id="prace" class="section">
	<div class="container">
		<header class="section__head reveal">
			<p class="eyebrow"><span>01</span> Vybraná práce</p>
			<h2 class="section__title">Projekty, které <em>běží</em> a&nbsp;slouží lidem každý den.</h2>
		</header>

		<ol class="projects">
			<li n:foreach="$projects as $i => $project" class="project reveal">
				<a href="{$project['url']}" class="project__link" target="_blank" rel="noopener">
					<span class="project__index mono">{sprintf('%02d', $i + 1)}</span>
					<span class="project__main">
						<span class="project__type mono">
							{$project['type']}
							<span n:ifset="$project['status']" class="project__status">{$project['status']}</span>
						</span>
						<span class="project__name">{$project['name']}</span>
					</span>
					<span class="project__desc">{$project['description']}</span>
					<span class="project__meta">
						<span class="project__stack mono">{implode("\u{a0}· ", $project['stack'])}</span>
						<span class="project__url mono">{preg_replace('~^https?://(www\.)?|/$~', '', $project['url'])} {include arrow}</span>
					</span>
				</a>
			</li>
		</ol>

		<p class="note reveal">Další projekty a reference rád ukážu osobně.</p>
	</div>
</section>

{* Two audiences *}
<section id="spoluprace" class="section section--tinted">
	<div class="container">
		<header class="section__head reveal">
			<p class="eyebrow"><span>02</span> Spolupráce</p>
			<h2 class="section__title">Dvě cesty, <em>jeden přístup.</em></h2>
		</header>

		<div class="paths">
			<article class="path reveal">
				<p class="path__label mono">Pro klienty</p>
				<h3 class="path__title">Potřebujete web, e-shop nebo aplikaci?</h3>
				<ul class="path__list">
					<li>Prezentační weby s redakčním systémem</li>
					<li>Rezervace, registrace a administrace na míru</li>
					<li>E-shopy s platbami a napojením na dopravce</li>
					<li>Nasazení, hosting a dlouhodobá péče</li>
				</ul>
				<a href="mailto:{$email}?subject=Popt%C3%A1vka%20projektu" class="button button--primary">Poptat projekt</a>
			</article>

			<article class="path path--dark reveal">
				<p class="path__label mono">Pro firmy a týmy</p>
				<h3 class="path__title">Hledáte posilu do vývojového týmu?</h3>
				<ul class="path__list">
					<li>Backend v PHP 8 (Nette, Symfony), návrh databází</li>
					<li>Frontend ve Vue.js a TypeScriptu</li>
					<li>Docker, Git, CI/CD a testy v Playwrightu</li>
					<li>Samostatnost: projekty od zadání po provoz</li>
				</ul>
				<div class="path__actions">
					<a href="{$linkedin}" class="button button--light" target="_blank" rel="noopener">{include linkedin} LinkedIn</a>
					<a href="mailto:{$email}?subject=Pracovn%C3%AD%20nab%C3%ADdka" class="button button--outline-light">Napsat e-mail</a>
				</div>
			</article>
		</div>
	</div>
</section>

{* Services *}
<section id="sluzby" class="section">
	<div class="container">
		<header class="section__head reveal">
			<p class="eyebrow"><span>03</span> Služby</p>
			<h2 class="section__title">S čím vám <em>můžu pomoct.</em></h2>
		</header>

		<ul class="services">
			<li n:foreach="$services as $i => [$title, $text]" class="service reveal">
				<span class="service__index mono">{sprintf('%02d', $i + 1)}</span>
				<h3 class="service__title">{$title}</h3>
				<p class="service__text">{$text}</p>
			</li>
		</ul>

		<div class="process reveal">
			<h3 class="process__title mono">Jak spolupráce probíhá</h3>
			<ol class="process__steps">
				<li n:foreach="$process as [$title, $text]">
					<strong>{$title}</strong>
					<span>{$text}</span>
				</li>
			</ol>
		</div>
	</div>
</section>

{* About *}
<section id="o-mne" class="section section--tinted">
	<div class="container about">
		<header class="section__head reveal">
			<p class="eyebrow"><span>04</span> O mně</p>
			<h2 class="section__title">Čistý kód, <em>jasná domluva.</em></h2>
		</header>

		<div class="about__text reveal">
			<p class="about__lead">
				Jsem vývojář s vášní pro čistý kód a moderní technologie. Specializuji se na webové
				aplikace v PHP (Nette, Symfony) a moderní frontend.
			</p>
			<p>
				Chci, aby aplikace byly rychlé, bezpečné a příjemné na používání, a aby
				pomáhaly podnikání růst. Nabízím kompletní servis od návrhu přes vývoj
				až po nasazení a následnou podporu.
			</p>
		</div>

		<div class="stack reveal">
			<div n:foreach="$stack as $group => $items" class="stack__group">
				<h3 class="stack__title mono">{$group}</h3>
				<ul class="tags">
					<li n:foreach="$items as $item">{$item}</li>
				</ul>
			</div>
		</div>
	</div>
</section>

{* Contact *}
<section id="kontakt" class="contact">
	<div class="container">
		<p class="eyebrow eyebrow--light reveal"><span>05</span> Kontakt</p>
		<h2 class="contact__title reveal">Máte projekt nebo volnou pozici? <em>Ozvěte se.</em></h2>

		<div class="contact__email reveal">
			<a href="mailto:{$email}" class="contact__link">{$email}</a>
			<button type="button" class="copy" data-copy="{$email}">
				<span data-copy-label>Kopírovat</span>
			</button>
		</div>

		<ul class="contact__social reveal">
			<li><a href="{$linkedin}" target="_blank" rel="noopener">{include linkedin} LinkedIn</a></li>
			<li><a href="{$github}" target="_blank" rel="noopener">{include github} GitHub</a></li>
		</ul>
	</div>
</section>

{/block}
