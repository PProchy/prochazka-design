        </div>
    </div>
</section>

{* About Section *}
<section id="about" class="py-24">
    <div class="max-w-6xl mx-auto px-6">
        <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center">O mně</h2>
        
        <div class="grid md:grid-cols-2 gap-12 items-center">
            <div>
                <p class="text-gray-400 text-lg leading-relaxed mb-6">
                    Jsem vývojář s vášní pro čistý kód a moderní technologie. 
                    Specializuji se na tvorbu webových aplikací v PHP (Nette Framework) 
                    a moderní frontendové technologie.
                </p>
                <p class="text-gray-400 text-lg leading-relaxed mb-6">
                    Mým cílem je vytvářet rychlé, bezpečné a uživatelsky přívětivé 
                    aplikace, které pomohou vašemu podnikání růst.
                </p>
                <p class="text-gray-400 text-lg leading-relaxed">
                    Nabízím kompletní servis od návrhu přes vývoj až po nasazení 
                    a následnou podporu.
                </p>
            </div>
            
            <div>
                <h3 class="text-xl font-semibold mb-6">Technologie</h3>
                <div class="flex flex-wrap gap-3">
                    <span class="px-4 py-2 bg-dark rounded-lg text-gray-300">PHP</span>
                    <span class="px-4 py-2 bg-dark rounded-lg text-gray-300">Nette</span>
                    <span class="px-4 py-2 bg-dark rounded-lg text-gray-300">MySQL</span>
                    <span class="px-4 py-2 bg-dark rounded-lg text-gray-300">PostgreSQL</span>
                    <span class="px-4 py-2 bg-dark rounded-lg text-gray-300">JavaScript</span>
                    <span class="px-4 py-2 bg-dark rounded-lg text-gray-300">TypeScript</span>
                    <span class="px-4 py-2 bg-dark rounded-lg text-gray-300">Vue.js</span>
                    <span class="px-4 py-2 bg-dark rounded-lg text-gray-300">Tailwind CSS</span>
                    <span class="px-4 py-2 bg-dark rounded-lg text-gray-300">Docker</span>
                    <span class="px-4 py-2 bg-dark rounded-lg text-gray-300">Git</span>
                    <span class="px-4 py-2 bg-dark rounded-lg text-gray-300">Playwright</span>
                    <span class="px-4 py-2 bg-dark rounded-lg text-gray-300">AI tools</span>
                </div>
            </div>
        </div>
    </div>
</section>

{* Services Section *}
<section id="services" class="py-24 bg-dark">
    <div class="max-w-6xl mx-auto px-6">
        <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center">Služby</h2>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            <div class="p-8 bg-darker rounded-xl border border-gray-800 hover:border-primary/50 transition">
                <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-6">
                    <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                </div>
                <h3 class="text-xl font-semibold mb-3">Webové aplikace</h3>
                <p class="text-gray-400">
                    Vývoj webových aplikací na míru - od jednoduchých webů 
                    po komplexní business systémy.
                </p>
            </div>
            
            <div class="p-8 bg-darker rounded-xl border border-gray-800 hover:border-primary/50 transition">
                <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-6">
                    <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                    </svg>
                </div>
                <h3 class="text-xl font-semibold mb-3">E-shopy</h3>
                <p class="text-gray-400">
                    Tvorba e-shopů s napojením na platební brány, 
                    dopravce a účetní systémy.
                </p>
            </div>
            
            <div class="p-8 bg-darker rounded-xl border border-gray-800 hover:border-primary/50 transition">
                <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-6">
                    <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                </div>
                <h3 class="text-xl font-semibold mb-3">API & Integrace</h3>
                <p class="text-gray-400">
                    Návrh a implementace REST API, integrace 
                    s externími službami a systémy.
                </p>
            </div>
            
            <div class="p-8 bg-darker rounded-xl border border-gray-800 hover:border-primary/50 transition">
                <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-6">
                    <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/>
                    </svg>
                </div>
                <h3 class="text-xl font-semibold mb-3">Responzivní design</h3>
                <p class="text-gray-400">
                    Weby optimalizované pro všechna zařízení - 
                    mobily, tablety i desktopy.
                </p>
            </div>
            
            <div class="p-8 bg-darker rounded-xl border border-gray-800 hover:border-primary/50 transition">
                <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-6">
                    <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                    </svg>
                </div>
                <h3 class="text-xl font-semibold mb-3">Optimalizace</h3>
                <p class="text-gray-400">
                    Zrychlení stávajících aplikací, SEO optimalizace 
                    a analýza výkonu.
                </p>
            </div>
            
            <div class="p-8 bg-darker rounded-xl border border-gray-800 hover:border-primary/50 transition">
                <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-6">
                    <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
                    </svg>
                </div>
                <h3 class="text-xl font-semibold mb-3">Podpora & Správa</h3>
                <p class="text-gray-400">
                    Dlouhodobá podpora, údržba a rozvoj 
                    vašich aplikací.
                </p>
            </div>
        </div>
    </div>
</section>

{* Portfolio Section *}
<section id="portfolio" class="py-24">
    <div class="max-w-6xl mx-auto px-6">
        <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center">Portfolio</h2>
        
        <div class="grid md:grid-cols-2 gap-8">
            <div class="group bg-dark rounded-xl overflow-hidden border border-gray-800 hover:border-primary/50 transition">
                <div class="h-48 bg-gradient-to-br from-primary/20 to-purple-500/20 flex items-center justify-center">
                    <span class="text-gray-500">Screenshot projektu</span>
                </div>
                <div class="p-6">
                    <h3 class="text-xl font-semibold mb-2">Název projektu</h3>
                    <p class="text-gray-400 mb-4">
                        Krátký popis projektu a jeho hlavních funkcí.
                    </p>
                    <div class="flex flex-wrap gap-2 mb-4">
                        <span class="px-3 py-1 text-sm bg-darker rounded-full text-gray-400">PHP</span>
                        <span class="px-3 py-1 text-sm bg-darker rounded-full text-gray-400">Nette</span>
                        <span class="px-3 py-1 text-sm bg-darker rounded-full text-gray-400">MySQL</span>
                    </div>
                    <a href="#" class="text-primary hover:underline">Zobrazit detail →</a>
                </div>
            </div>
            
            <div class="group bg-dark rounded-xl overflow-hidden border border-gray-800 hover:border-primary/50 transition">
                <div class="h-48 bg-gradient-to-br from-green-500/20 to-blue-500/20 flex items-center justify-center">
                    <span class="text-gray-500">Screenshot projektu</span>
                </div>
                <div class="p-6">
                    <h3 class="text-xl font-semibold mb-2">Název projektu</h3>
                    <p class="text-gray-400 mb-4">
                        Krátký popis projektu a jeho hlavních funkcí.
                    </p>
                    <div class="flex flex-wrap gap-2 mb-4">
                        <span class="px-3 py-1 text-sm bg-darker rounded-full text-gray-400">Vue.js</span>
                        <span class="px-3 py-1 text-sm bg-darker rounded-full text-gray-400">TypeScript</span>
                        <span class="px-3 py-1 text-sm bg-darker rounded-full text-gray-400">API</span>
                    </div>
                    <a href="#" class="text-primary hover:underline">Zobrazit detail →</a>
                </div>
            </div>
        </div>
        
        <p class="text-center text-gray-500 mt-8">
            Další projekty na vyžádání
        </p>
    </div>
</section>

