{block content}

{* Hero Section *}
<section class="min-h-screen flex items-center justify-center pt-20">
    <div class="max-w-6xl mx-auto px-6 text-center">
        <p class="text-primary font-medium mb-4">Ahoj, jsem</p>
        <h1 class="text-5xl md:text-7xl font-bold mb-6">
            Ing. Pavel Procházka
        </h1>
        <p class="text-xl md:text-2xl text-gray-400 mb-8 max-w-2xl mx-auto">
            Full-stack vývojář specializující se na webové aplikace, 
            e-shopy a API řešení na míru.
        </p>
        <div class="flex gap-4 justify-center flex-wrap">
            <a href="#contact" class="px-8 py-3 bg-primary hover:bg-blue-600 rounded-lg font-medium transition">
                Kontaktovat
            </a>
            <a href="#portfolio" class="px-8 py-3 border border-gray-700 hover:border-gray-500 rounded-lg font-medium transition">
                Moje práce
            </a>
        </div>
        
        <div class="mt-16 flex justify-center gap-6">
            <a href="https://github.com/PProchy" target="_blank" class="text-gray-500 hover:text-white transition">
