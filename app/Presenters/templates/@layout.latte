<!DOCTYPE html>
<html lang="cs">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="description" content="Ing. Pavel Procházka, full-stack vývojář. Webové aplikace, e-shopy, rezervační systémy a API na míru v PHP (Nette, Symfony) a Vue.js. Od návrhu po nasazení a správu.">
	<meta name="author" content="Pavel Procházka">
	<meta name="robots" content="{ifset robots}{include robots}{else}index, follow{/ifset}">
	<meta name="theme-color" content="#f3efe6" media="(prefers-color-scheme: light)">
	<meta name="theme-color" content="#13120f" media="(prefers-color-scheme: dark)">
	<link rel="canonical" href="https://prochazka-design.cz/">

	{* Open Graph *}
	<meta property="og:type" content="website">
	<meta property="og:url" content="https://prochazka-design.cz/">
	<meta property="og:title" content="Pavel Procházka – full-stack webový vývojář">
	<meta property="og:description" content="Full-stack vývojář. Webové aplikace, e-shopy, rezervační systémy a API na míru v PHP (Symfony, Nette) a Vue.js. Od návrhu přes vývoj až po nasazení a správu.">
	<meta property="og:image" content="https://prochazka-design.cz/og-image.png">
	<meta property="og:image:width" content="1200">
	<meta property="og:image:height" content="630">
	<meta property="og:locale" content="cs_CZ">
	<meta property="og:site_name" content="Procházka Design">
	<meta name="twitter:card" content="summary_large_image">

	{* Structured Data - JSON-LD *}
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "Person",
		"name": "Pavel Procházka",
		"honorificPrefix": "Ing.",
		"jobTitle": "Full-stack Web Developer",
		"url": "https://prochazka-design.cz",
		"email": "mailto:pprochy55@gmail.com",
		"address": {
			"@type": "PostalAddress",
			"addressLocality": "Mělník",
			"addressCountry": "CZ"
		},
		"sameAs": [
			"https://github.com/PProchy",
			"https://www.linkedin.com/in/pavel-proch%C3%A1zka-b20930192/"
		],
		"knowsAbout": ["PHP", "Nette Framework", "Symfony", "JavaScript", "TypeScript", "Vue.js", "MySQL", "PostgreSQL", "Docker", "Tailwind"],
		"makesOffer": {
			"@type": "Offer",
			"itemOffered": {
				"@type": "Service",
				"name": "Vývoj webových aplikací",
				"description": "Tvorba webových aplikací, e-shopů a API na míru"
			}
		}
	}
	</script>

	<link rel="icon" href="{$basePath}/favicon.svg" type="image/svg+xml">
	<link rel="icon" href="{$basePath}/favicon.png" type="image/png" sizes="64x64">
	<link rel="apple-touch-icon" href="{$basePath}/apple-touch-icon.png">

	{* Fonts used above the fold; the rest load on demand *}
	<link rel="preload" href="{$basePath}/fonts/fraunces-normal-latin.woff2" as="font" type="font/woff2" crossorigin>
	<link rel="preload" href="{$basePath}/fonts/geist-normal-latin.woff2" as="font" type="font/woff2" crossorigin>
	<link rel="stylesheet" href="{$basePath}/css/main.css?v={$assetVersion}">
	<script>document.documentElement.classList.add('js');</script>
	<script src="{$basePath}/js/main.js?v={$assetVersion}" defer></script>

	<title>{ifset title}{include title|stripHtml} | {/ifset}Pavel Procházka – full-stack vývojář</title>
</head>

<body>
<a href="#main" class="skip-link">Přeskočit na obsah</a>

<header class="site-header" data-header>
	<div class="container site-header__inner">
		<a href="{$basePath}/" class="wordmark" aria-label="Pavel Procházka – úvod">
			<span class="wordmark__mark" aria-hidden="true">PD</span>
			<span class="wordmark__name">Pavel Procházka</span>
		</a>

		<nav class="site-nav" id="site-nav" aria-label="Hlavní navigace">
			<ul>
				<li><a href="{$basePath}/#prace">Práce</a></li>
				<li><a href="{$basePath}/#spoluprace">Spolupráce</a></li>
				<li><a href="{$basePath}/#sluzby">Služby</a></li>
				<li><a href="{$basePath}/#o-mne">O mně</a></li>
				<li><a href="{$basePath}/#kontakt" class="site-nav__cta">Napište mi</a></li>
			</ul>
		</nav>

		<button type="button" class="menu-toggle" aria-controls="site-nav" aria-expanded="false" data-menu-toggle>
			<span class="visually-hidden">Menu</span>
			<span class="menu-toggle__bar" aria-hidden="true"></span>
			<span class="menu-toggle__bar" aria-hidden="true"></span>
		</button>
	</div>
</header>

<div n:foreach="$flashes as $flash" class="flash">{$flash->message}</div>

<main id="main">
	{include content}
</main>

<footer class="site-footer">
	<div class="container site-footer__inner">
		<p>&copy; {date('Y')} Ing. Pavel Procházka</p>
		<p>IČO: 08214093 · Na Brabčově 4124, 276 01 Mělník · zapsán v živnostenském rejstříku</p>
	</div>
</footer>

{block scripts}{/block}
</body>
</html>
