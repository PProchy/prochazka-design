{block title}Stránka nenalezena{/block}

{block content}
<section class="min-h-screen flex items-center justify-center relative overflow-hidden pt-20">
    {* Scan lines overlay *}
    <div class="scanlines"></div>
    
    <div class="text-center z-10 px-6">
        {* Glitch 404 *}
        <h1 class="glitch text-[10rem] md:text-[14rem] lg:text-[16rem] font-bold leading-none mb-4" data-text="404">404</h1>
        
        {* Vtipná hláška *}
        <p class="text-xl md:text-2xl text-gray-300 mb-2">
            Tuhle stránku jsem ještě nenapsal...
        </p>
        <p class="text-gray-500 mb-8 font-mono text-sm md:text-base">
            <span class="error-code">ERROR: PAGE_NOT_FOUND</span>
        </p>
        
        {* Návrat na hlavní *}
        <a href="/" class="inline-block px-8 py-3 bg-primary hover:bg-blue-600 rounded-lg font-medium transition">
            Zpět na hlavní stránku
        </a>
    </div>
</section>
{/block}

{block scripts}
<style>
    .glitch {
        position: relative;
        color: #f1f5f9;
        animation: glitch-skew 1s infinite linear alternate-reverse;
    }

    .glitch::before,
    .glitch::after {
        content: attr(data-text);
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }

    .glitch::before {
        color: #ff0080;
        animation: glitch-anim 2s infinite linear alternate-reverse;
        clip-path: polygon(0 0, 100% 0, 100% 35%, 0 35%);
        transform: translate(-3px, -3px);
    }

    .glitch::after {
        color: #00ffff;
        animation: glitch-anim2 2s infinite linear alternate-reverse;
        clip-path: polygon(0 65%, 100% 65%, 100% 100%, 0 100%);
        transform: translate(3px, 3px);
    }

    @keyframes glitch-anim {
        0% {
            clip-path: polygon(0 0, 100% 0, 100% 35%, 0 35%);
            transform: translate(-3px, -3px);
        }
        20% {
            clip-path: polygon(0 15%, 100% 15%, 100% 45%, 0 45%);
            transform: translate(3px, -2px);
        }
        40% {
            clip-path: polygon(0 30%, 100% 30%, 100% 55%, 0 55%);
            transform: translate(-2px, 3px);
        }
        60% {
            clip-path: polygon(0 45%, 100% 45%, 100% 70%, 0 70%);
            transform: translate(2px, 2px);
        }
        80% {
            clip-path: polygon(0 60%, 100% 60%, 100% 85%, 0 85%);
            transform: translate(-3px, -3px);
        }
        100% {
            clip-path: polygon(0 80%, 100% 80%, 100% 100%, 0 100%);
            transform: translate(3px, -2px);
        }
    }

    @keyframes glitch-anim2 {
        0% {
            clip-path: polygon(0 65%, 100% 65%, 100% 100%, 0 100%);
            transform: translate(3px, 3px);
        }
        20% {
            clip-path: polygon(0 55%, 100% 55%, 100% 85%, 0 85%);
            transform: translate(-2px, 2px);
        }
        40% {
            clip-path: polygon(0 45%, 100% 45%, 100% 75%, 0 75%);
            transform: translate(3px, -3px);
        }
        60% {
            clip-path: polygon(0 35%, 100% 35%, 100% 60%, 0 60%);
            transform: translate(-3px, 3px);
        }
        80% {
            clip-path: polygon(0 20%, 100% 20%, 100% 50%, 0 50%);
            transform: translate(2px, -2px);
        }
        100% {
            clip-path: polygon(0 0, 100% 0, 100% 35%, 0 35%);
            transform: translate(-2px, 2px);
        }
    }

    @keyframes glitch-skew {
        0% {
            transform: skew(0deg);
        }
        10% {
            transform: skew(1deg);
        }
        20% {
            transform: skew(-1deg);
        }
        30% {
            transform: skew(0.5deg);
        }
        40% {
            transform: skew(-0.5deg);
        }
        50% {
            transform: skew(0deg);
        }
        60% {
            transform: skew(-0.5deg);
        }
        70% {
            transform: skew(0.5deg);
        }
        80% {
            transform: skew(-1deg);
        }
        90% {
            transform: skew(1deg);
        }
        100% {
            transform: skew(0deg);
        }
    }

    .scanlines {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: repeating-linear-gradient(
            0deg,
            rgba(0, 0, 0, 0.1),
            rgba(0, 0, 0, 0.1) 1px,
            transparent 1px,
            transparent 2px
        );
        pointer-events: none;
        z-index: 20;
    }

    .scanlines::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(
            180deg,
            transparent 0%,
            rgba(59, 130, 246, 0.03) 50%,
            transparent 100%
        );
        animation: scanline-move 8s linear infinite;
    }

    @keyframes scanline-move {
        0% {
            transform: translateY(-100%);
        }
        100% {
            transform: translateY(100%);
        }
    }

    .error-code {
        display: inline-block;
        animation: flicker 3s infinite;
    }

    @keyframes flicker {
        0%, 100% {
            opacity: 1;
        }
        92% {
            opacity: 1;
        }
        93% {
            opacity: 0.3;
        }
        94% {
            opacity: 1;
        }
        95% {
            opacity: 0.5;
        }
        96% {
            opacity: 1;
        }
    }
</style>
{/block}
