{block robots}noindex{/block}

{block content}
<section class="container error-page">
	<p class="error-page__code">404</p>
	<h1 class="error-page__title">Tuhle stránku jsem ještě nenapsal</h1>
	<p class="error-page__text">Adresa neexistuje nebo se přesunula. <code>ERROR: PAGE_NOT_FOUND</code></p>
	<p><a href="{$basePath}/" class="button button--primary">Zpět na úvod</a></p>
</section>
{/block}
