# Apache configuration file (see https://httpd.apache.org/docs/current/mod/quickreference.html)
Require all granted

# disable directory listing
<IfModule mod_autoindex.c>
	Options -Indexes
</IfModule>

# enable cool URL
<IfModule mod_rewrite.c>
	RewriteEngine On
	# RewriteBase /

	# use HTTPS (only on production, not localhost)
	RewriteCond %{HTTPS} off
	RewriteCond %{HTTP_HOST} !^localhost
	RewriteRule (.*) https://%{SERVER_NAME}/$1 [R=301,L]

	# prevents files starting with dot to be viewed by browser
	RewriteRule /\.|^\.(?!well-known/) - [F]

	# front controller
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule !\.(pdf|js|mjs|ico|gif|jpg|jpeg|png|webp|svg|css|rar|zip|7z|tar\.gz|map|eot|ttf|otf|woff|woff2)$ index.php [L]

	# pass HTTP Authorization header
	RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization},L]
</IfModule>

# browser cache for static files; HTML is generated by Nette and is never cached here
<IfModule mod_mime.c>
	AddType font/woff2 .woff2
</IfModule>

<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresDefault "access plus 0 seconds"

	# main.css and main.js get ?v=<mtime> from the layout, so they can be cached for a long time
	ExpiresByType text/css "access plus 1 year"
	ExpiresByType text/javascript "access plus 1 year"
	ExpiresByType application/javascript "access plus 1 year"
	ExpiresByType font/woff2 "access plus 1 year"

	# images keep their URL when they change, so only a week
	ExpiresByType image/png "access plus 1 week"
	ExpiresByType image/svg+xml "access plus 1 week"
	ExpiresByType image/x-icon "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
	<FilesMatch "\.(css|js|woff2)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
</IfModule>

# enable gzip compression
<IfModule mod_deflate.c>
	<IfModule mod_filter.c>
		AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/xml image/svg+xml
	</IfModule>
</IfModule>
